generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
  relationMode = "foreignKeys"
}

model Permission {
  id          String   @id @default(cuid()) @db.VarChar(30)
  module      String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  code        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.VarChar(30)
  permissionId String @map("permission_id") @db.VarChar(30)

  createdAt   DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Role {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  users           User[]
  rolePermissions RolePermission[]
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

model User {
  id        String @id @default(cuid()) @db.VarChar(30)

  email     String @unique @db.VarChar(100)
  username  String @unique @db.VarChar(50)
  password  String @db.VarChar(255)

  status                   UserStatus @default(ACTIVE)
  mustChangePassword       Boolean @default(true) @map("must_change_password")
  twoFactorEnabled         Boolean @default(false) @map("two_factor_enabled")
  failedLoginAttempts      Int @default(0) @map("failed_login_attempts")
  lockedUntil              DateTime? @map("locked_until")
  lastLoginAt              DateTime? @map("last_login_at")
  emailVerifiedAt          DateTime? @map("email_verified_at")

  roleId String @map("role_id") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id])

  profile UserProfile?

  entries     Entry[]
  exits       Exit[]
  inventories Inventory[]

  @@map("users")
}

model UserProfile {
  id             String    @id @default(cuid()) @db.VarChar(30)
  userId         String    @unique @map("user_id") @db.VarChar(30)

  employeeCode   String    @unique @map("employee_code") @db.VarChar(30)

  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  displayName    String    @map("display_name") @db.VarChar(150)
  profilePhoto   String?   @map("profile_photo") @db.VarChar(255)

  phone          String?   @db.VarChar(30)
  secondaryPhone String?   @map("secondary_phone") @db.VarChar(30)

  birthDate      DateTime? @map("birth_date") @db.Date
  gender         String?   @db.VarChar(20)

  address        String?   @db.VarChar(255)
  city           String?   @db.VarChar(100)
  region         String?   @db.VarChar(100)
  country        String?   @db.VarChar(100)
  postalCode     String?   @map("postal_code") @db.VarChar(20)

  departmentId   String?   @map("department_id") @db.VarChar(30)
  jobTitleId     String?   @map("job_title_id") @db.VarChar(30)
  warehouseId    String?   @map("warehouse_id") @db.VarChar(30)

  signature      String?   @db.Text

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])
  jobTitle   JobTitle?   @relation(fields: [jobTitleId], references: [id])
  warehouse  Warehouse?  @relation(fields: [warehouseId], references: [id])

  @@map("user_profiles")
}

model Department {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(30)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userProfiles UserProfile[]

  @@map("departments")
}

model JobTitle {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(30)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userProfiles UserProfile[]

  @@map("job_titles")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(150)
  slug        String  @unique @db.VarChar(180)
  description String? @db.Text

  // Relation récursive
  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")

  // Gestion
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
  @@index([parentId, sortOrder])
  @@map("categories")
}

model Brand {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(180)
  description String?  @db.Text
  logoUrl     String?  @map("logo_url") @db.VarChar(500)

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([name])
  @@index([isActive])
  @@map("brands")
}

model UnitOfMeasure {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(20)
  symbol      String?  @db.VarChar(10)
  description String?  @db.Text

  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([name])
  @@index([isActive])
  @@map("units_of_measure")
}

model Product {
  id   Int    @id @default(autoincrement())

  // ─────────────────────────────────────────────
  // Identité produit
  // ─────────────────────────────────────────────

  sku         String  @unique @db.VarChar(100)
  name        String  @db.VarChar(200)
  slug        String  @unique @db.VarChar(220)

  description String? @db.Text

  // ─────────────────────────────────────────────
  // Référentiels
  // ─────────────────────────────────────────────

  brandId    Int?
  categoryId Int?
  unitId     Int

  brand    Brand?        @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  unit     UnitOfMeasure @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // ─────────────────────────────────────────────
  // Médias
  // ─────────────────────────────────────────────

  images ProductImage[]

  // ─────────────────────────────────────────────
  // Identification / scan
  // ─────────────────────────────────────────────

  barcodes ProductBarcode[]

  // ─────────────────────────────────────────────
  // Statut
  // ─────────────────────────────────────────────

  isActive Boolean @default(true)

  // ─────────────────────────────────────────────
  // Audit
  // ─────────────────────────────────────────────

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─────────────────────────────────────────────
  // Index
  // ─────────────────────────────────────────────

  @@index([name])
  @@index([brandId])
  @@index([categoryId])
  @@index([unitId])
  @@index([isActive])

  @@map("products")
}

enum ImageStorageProvider {
  CLOUDINARY
  S3
  R2
  MINIO
  LOCAL
}

model ProductImage {
  id        Int    @id @default(autoincrement())

  productId Int @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // URL publique/CDN
  url       String @db.VarChar(1000)

  // Identifiant du fichier chez Cloudinary/S3/etc.
  storageKey String? @map("storage_key") @db.VarChar(500)

  // Provider de stockage
  provider  ImageStorageProvider @default(CLOUDINARY)

  // Informations d'affichage
  alt       String? @db.VarChar(255)

  // Image principale du produit
  isPrimary Boolean @default(false) @map("is_primary")

  // Ordre d'affichage
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([productId, sortOrder])
  @@index([productId, isPrimary])

  @@map("product_images")
}

enum BarcodeType {
  EAN8
  EAN13
  EAN14
  UPC_A
  UPC_E
  CODE128
  CODE39
  ITF14
  GS1_128
  QR
  OTHER
}

model ProductBarcode {
  id        Int    @id @default(autoincrement())

  productId Int @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Valeur réelle du code-barres
  code      String @unique @db.VarChar(100)

  // Type de code
  type      BarcodeType @default(EAN13)

  // Code principal utilisé par défaut
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([productId, isPrimary])
  @@index([type])

  @@map("product_barcodes")
}

model Warehouse {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String   @db.VarChar(100)
  location  String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zones            Zone[]
  userProfiles  UserProfile[]
  entries        Entry[]
  exits          Exit[]
  inventories    Inventory[]

  @@map("warehouses")
}

model Zone {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouseId String @map("warehouse_id") @db.VarChar(30)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("zones")
}

model Supplier {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String   @db.VarChar(100)
  email     String?  @db.VarChar(100)
  phone     String?  @db.VarChar(30)
  address   String?  @db.VarChar(255)
  contact   String?  @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries Entry[]

  @@map("suppliers")
}

model Entry {
  id          String   @id @default(cuid()) @db.VarChar(30)
  reference   String   @unique @db.VarChar(50)
  date        DateTime @default(now())
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  supplierId String @map("supplier_id") @db.VarChar(30)
  userId     String @map("user_id") @db.VarChar(30)

  supplier Supplier   @relation(fields: [supplierId], references: [id])
  user     User       @relation(fields: [userId], references: [id])
  warehouseId String  @map("warehouse_id") @db.VarChar(30)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("entries")
}

model Exit {
  id          String   @id @default(cuid()) @db.VarChar(30)
  reference   String   @unique @db.VarChar(50)
  date        DateTime @default(now())
  type        String   @default("vente") @db.VarChar(30)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId      String @map("user_id")
  warehouseId String @map("warehouse_id")

  user      User       @relation(fields: [userId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("exits")
}

model Inventory {
  id          String   @id @default(cuid()) @db.VarChar(30)
  reference   String   @unique @db.VarChar(50)
  date        DateTime @default(now())
  status      String   @default("en_cours") @db.VarChar(30)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId      String @map("user_id") @db.VarChar(30)
  warehouseId String @map("warehouse_id") @db.VarChar(30)

  user      User       @relation(fields: [userId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("inventories")
}
